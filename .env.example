# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your-secret-key
JWT_REFRESH_SECRET=your-refresh-secret
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── bcrypt ───────────────────────────────────────────────────────────────────
# Higher values = more secure but slower. 12 is a good default for production.
BCRYPT_SALT_ROUNDS=12

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tickoff
POSTGRES_USER=tickoff_user
POSTGRES_PASSWORD=tickoff_password

# ─── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ─── Firebase ─────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=tickoff-test
# Set FIRESTORE_EMULATOR_HOST when using the local emulator, e.g.:
# FIRESTORE_EMULATOR_HOST=localhost:9099

# ─── FCM (Firebase Cloud Messaging) ──────────────────────────────────────────
# Server key for sending push notifications (leave empty to use Application Default Credentials)
FCM_SERVER_KEY=

# ─── Service ports ────────────────────────────────────────────────────────────
AUTH_SERVICE_PORT=3001
TICKMAP_SERVICE_PORT=3002
PUSH_SERVICE_PORT=3003
USER_SERVICE_PORT=3004

# ─── Log level ────────────────────────────────────────────────────────────────
# Options: error | warn | info | debug
LOG_LEVEL=info
