meta {
  name: Health Check
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/health
  body: none
  auth: none
}

vars:pre-request {
  baseUrl: http://localhost:3002
}

assert {
  res.status: eq 200
  res.body.status: eq ok
  res.body.service: eq tickmap-service
}

docs {
  Returns the health status of the TickMap Service.
}
