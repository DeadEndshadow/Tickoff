meta {
  name: Health Check
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/health
  body: none
  auth: none
}

vars:pre-request {
  baseUrl: http://localhost:3001
}

assert {
  res.status: eq 200
  res.body.status: eq ok
  res.body.service: eq auth-service
}

docs {
  Returns the health status of the Auth Service.
  Used as a liveness probe and by Docker healthcheck.
}
