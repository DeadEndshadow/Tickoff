meta {
  name: Register User
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

vars:pre-request {
  baseUrl: http://localhost:3001
}

body:json {
  {
    "email": "test@tickoff.ch",
    "password": "Secret123!",
    "displayName": "Test User"
  }
}

assert {
  res.status: eq 201
  res.body.token: isDefined
  res.body.user.email: eq test@tickoff.ch
  res.body.user.role: eq user
}

script:post-response {
  bru.setVar("authToken", res.body.token);
  bru.setVar("userId", res.body.user.id);
}

docs {
  Creates a new user account.
  Returns a JWT token on success.
  Returns 409 if the email is already registered (idempotency guard).
}
