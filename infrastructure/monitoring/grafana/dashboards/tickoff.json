{
  "title": "TickOff Monitoring",
  "uid": "tickoff-main",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "KPI 1 — Kafka Consumer Lag",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 4 },
      "targets": [
        {
          "expr": "kafka_consumergroup_lag{consumergroup=\"analytics-service\"}",
          "legendFormat": "Lag",
          "datasource": "Prometheus"
        }
      ],
      "options": { "colorMode": "background", "graphMode": "area", "orientation": "auto" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          },
          "mappings": []
        }
      }
    },
    {
      "id": 2,
      "title": "KPI 2 — Processing Errors (last 5m)",
      "type": "stat",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 4 },
      "targets": [
        {
          "expr": "increase(tickoff_processing_errors_total[5m])",
          "legendFormat": "Errors",
          "datasource": "Prometheus"
        }
      ],
      "options": { "colorMode": "background", "graphMode": "area" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "KPI 3 — PostgreSQL Active Connections",
      "type": "stat",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 4 },
      "targets": [
        {
          "expr": "pg_stat_activity_count{datname=\"tickoff\"}",
          "legendFormat": "Connections",
          "datasource": "Prometheus"
        }
      ],
      "options": { "colorMode": "background", "graphMode": "area" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 8 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Analytics Events Received (total)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 4, "w": 6, "h": 3 },
      "targets": [
        {
          "expr": "tickoff_events_received_total",
          "legendFormat": "Total",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "blue", "value": 0 }] } } }
    },
    {
      "id": 5,
      "title": "Events per Minute",
      "type": "stat",
      "gridPos": { "x": 6, "y": 4, "w": 6, "h": 3 },
      "targets": [
        {
          "expr": "rate(tickoff_events_received_total[1m]) * 60",
          "legendFormat": "Events/min",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": { "defaults": { "decimals": 1, "thresholds": { "steps": [{ "color": "blue", "value": 0 }] } } }
    },
    {
      "id": 6,
      "title": "Analytics API Requests/sec",
      "type": "stat",
      "gridPos": { "x": 12, "y": 4, "w": 6, "h": 3 },
      "targets": [
        {
          "expr": "rate(flask_http_request_total[1m])",
          "legendFormat": "Req/sec",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": { "defaults": { "decimals": 2, "thresholds": { "steps": [{ "color": "green", "value": 0 }] } } }
    },
    {
      "id": 7,
      "title": "PostgreSQL DB Size",
      "type": "stat",
      "gridPos": { "x": 18, "y": 4, "w": 6, "h": 3 },
      "targets": [
        {
          "expr": "pg_database_size_bytes{datname=\"tickoff\"}",
          "legendFormat": "Size",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "thresholds": { "steps": [{ "color": "green", "value": 0 }] } } }
    },
    {
      "id": 8,
      "title": "Events Over Time by Type",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 7, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(tickoff_events_received_total[2m])",
          "legendFormat": "{{event_type}}",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 10 } } }
    },
    {
      "id": 9,
      "title": "Analytics API Response Time (p95)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 7, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(flask_http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p95 latency",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 10,
      "title": "Kafka — Consumer Lag Over Time",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 15, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "kafka_consumergroup_lag",
          "legendFormat": "{{consumergroup}} / {{topic}}",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2 },
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      }
    },
    {
      "id": 11,
      "title": "Kafka — Messages In/sec",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 15, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(kafka_topic_partition_current_offset[1m])",
          "legendFormat": "{{topic}}",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 10 } } }
    },
    {
      "id": 12,
      "title": "Container Logs",
      "type": "logs",
      "gridPos": { "x": 0, "y": 23, "w": 24, "h": 10 },
      "targets": [
        {
          "expr": "{service=~\"analytics-service|mock-api|kafka|postgres\"}",
          "legendFormat": "",
          "datasource": "Loki"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ]
}