{
  "title": "TickOff Monitoring",
  "uid": "tickoff-main",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Analytics Events Received (total)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "tickoff_events_received_total",
          "legendFormat": "Total Events",
          "datasource": "Prometheus"
        }
      ],
      "options": { "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": 0 }] } } }
    },
    {
      "id": 2,
      "title": "Events per Minute",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "rate(tickoff_events_received_total[1m]) * 60",
          "legendFormat": "Events/min",
          "datasource": "Prometheus"
        }
      ],
      "options": { "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "decimals": 1, "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "blue", "value": 0 }] } } }
    },
    {
      "id": 3,
      "title": "Analytics Service - HTTP Requests/sec",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "rate(flask_http_request_total[1m])",
          "legendFormat": "Req/sec",
          "datasource": "Prometheus"
        }
      ],
      "options": { "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "decimals": 2, "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": 0 }] } } }
    },
    {
      "id": 4,
      "title": "Processing Errors",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "tickoff_processing_errors_total",
          "legendFormat": "Errors",
          "datasource": "Prometheus"
        }
      ],
      "options": { "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 1 }] } } }
    },
    {
      "id": 5,
      "title": "Events Over Time by Type",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(tickoff_events_received_total[2m])",
          "legendFormat": "{{event_type}}",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 10 } } }
    },
    {
      "id": 6,
      "title": "Analytics API Response Time (p95)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(flask_http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p95 latency",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 7,
      "title": "Kafka - Messages In/sec",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(kafka_topic_partition_current_offset[1m])",
          "legendFormat": "{{topic}}",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 10 } } }
    },
    {
      "id": 8,
      "title": "Kafka - Consumer Lag",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "kafka_consumergroup_lag",
          "legendFormat": "{{consumergroup}} / {{topic}}",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2 }, "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 100 }, { "color": "red", "value": 1000 }] } } }
    },
    {
      "id": 9,
      "title": "PostgreSQL - Active Connections",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 20, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "pg_stat_activity_count",
          "legendFormat": "{{state}}",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 10,
      "title": "PostgreSQL - Rows Inserted/sec",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 20, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "rate(pg_stat_user_tables_n_tup_ins[1m])",
          "legendFormat": "{{relname}}",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 10 } } }
    },
    {
      "id": 11,
      "title": "PostgreSQL - DB Size",
      "type": "stat",
      "gridPos": { "x": 16, "y": 20, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "pg_database_size_bytes{datname=\"tickoff\"}",
          "legendFormat": "tickoff DB",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": 0 }] } } }
    }
  ]
}